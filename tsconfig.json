{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/auth": [
        "./src/backend/lib/auth/auth.ts"
      ],
      "@/auth.config": [
        "./src/backend/lib/auth/auth.config.ts"
      ],
      "@/proxy": [
        "./src/backend/lib/network/proxy.ts"
      ],
      "@/frontend/*": [
        "./src/frontend/*"
      ],
      "@/backend/*": [
        "./src/backend/*"
      ],
      "@/components/*": [
        "./src/frontend/components/*"
      ],
      "@/hooks/*": [
        "./src/frontend/hooks/*"
      ],
      "@/contexts/*": [
        "./src/frontend/contexts/*"
      ],
      "@/context/*": [
        "./src/frontend/contexts/*"
      ],
      "@/constants/*": [
        "./src/frontend/constants/*"
      ],
      "@/lib/*": [
        "./src/backend/lib/*"
      ],
      "@/utils/*": [
        "./src/backend/utils/*"
      ],
      "@/types/*": [
        "./src/backend/types/*"
      ],
      "@/config/*": [
        "./src/backend/config/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}